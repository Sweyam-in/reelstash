# ReelStash local development settings.
# Copy to .env.local (gitignored). Used by scripts/dev.sh (native) and scripts/dev-docker.sh (Compose).

# --- PostgreSQL ---------------------------------------------------------------
# dev.sh uses a PostgreSQL already listening on localhost:POSTGRES_PORT, or starts a
# container for you (scripts/dev-db.sh). dev-docker.sh runs its own PostgreSQL service.
POSTGRES_USER=reelstash
POSTGRES_PASSWORD=reelstash
POSTGRES_DB=reelstash
POSTGRES_PORT=5432
# Overrides the URL built from the values above.
# DATABASE_URL=

# --- Server -------------------------------------------------------------------
REELSTASH_ADDR=:8902
REELSTASH_SERVER_NAME=ReelStash
REELSTASH_PUBLIC_ORIGIN=http://localhost:8902
# Comma-separated origins when media and admin run on different hosts (optional).
# The app and the admin run on separate dev ports; these let each link across to the other.
REELSTASH_MEDIA_URLS=http://localhost:3000
REELSTASH_ADMIN_URLS=http://localhost:3001
TZ=UTC

# --- Sign-in ------------------------------------------------------------------
# Local only: a single shared password. Keep false anywhere reachable by others.
EMERGENCY_LOCAL_AUTH=true
EMERGENCY_LOCAL_PASSWORD=admin
# Or create the first admin from env:
# REELSTASH_ADMIN_USERNAME=
# REELSTASH_ADMIN_PASSWORD=

# --- Media --------------------------------------------------------------------
# Host directory with your media. Mounted at /mnt in Compose; add it as a
# library path in the app when running natively.
MEDIA_ROOT=./data/media


# --- Downloads (qBittorrent) --------------------------------------------------
# Compose: COMPOSE_PROFILES=downloads adds qBittorrent on the same media mount
# (scripts/dev-docker.sh). Native dev: point REELSTASH_QBIT_URL at any qBittorrent.
# COMPOSE_PROFILES=downloads
# REELSTASH_QBIT_URL=http://qbittorrent:8080
# QBIT_USERNAME=admin
# QBIT_PASSWORD=change-me-please
# QBIT_BIND_ADDR=0.0.0.0     # 127.0.0.1 keeps qBittorrent's own web UI to this machine
# QBIT_WEBUI_PORT=8080
# TORRENT_PORT=6881
# MEDIA_UID=1000             # owner of the media files on the host; qBittorrent runs as it
# MEDIA_GID=1000

# --- Tuning (defaults shown by the server; uncomment to change) ----------------
# REELSTASH_SCAN_WORKERS=4
# REELSTASH_SCAN_FILE_WORKERS=4
# REELSTASH_THUMBNAIL_WORKERS=2
# REELSTASH_HLS_WORKERS=0
# REELSTASH_DB_MAX_CONNS=0
