<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ReelStash" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/rs_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.ReelStash.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/rs_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.ReelStash</item>
    </style>

    <style name="Theme.ReelStash.Player" parent="Theme.ReelStash">
        <item name="android:windowBackground">@android:color/black</item>
    </style>
</resources>
